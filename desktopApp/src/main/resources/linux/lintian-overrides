# Lintian Overrides
#
# Suppresses expected Lintian static analysis messages for jpackage-generated
# application structure and bundled JVM/Skiko third-party libraries.
#
# Call lintian in bash terminal: `lintian -EviIL +pedantic <release.deb>`
#
photo-uploader: dir-or-file-in-opt *
photo-uploader: jar-not-in-usr-share *
photo-uploader: codeless-jar *
photo-uploader: embedded-library *
photo-uploader: extra-license-file *
photo-uploader: package-contains-documentation-outside-usr-share-doc *
photo-uploader: exit-in-shared-library *
photo-uploader: repeated-path-segment *
photo-uploader: maintainer-script-empty *
photo-uploader: no-md5sums-control-file
photo-uploader: spelling-error-in-binary *
